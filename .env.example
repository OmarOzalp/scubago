# Copy to .env and fill in from the Supabase dashboard → Project Settings → API Keys.
# Without these the app runs fully local (no auth, no sync).
#
# Only the project URL and the PUBLISHABLE key (sb_publishable_…) belong here: everything named
# EXPO_PUBLIC_* is compiled into the app, where anyone can read it. Never put the secret key
# (sb_secret_…) or the legacy service_role key in an EXPO_PUBLIC_ variable: the app refuses
# them, and `npm run check:env` (run on every EAS build) fails if one is present.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Older projects: the legacy anon key works too (used only if the publishable key is unset).
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
