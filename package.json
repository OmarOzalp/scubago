  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "tsx scripts/check-public-env.ts --web && expo export --platform web --clear",
    "lint": "expo lint",
    "test": "jest",
    "verify:marine": "tsx scripts/verify-marine.mjs",
    "verify:underwater": "tsx scripts/verify-underwater.mjs",
    "verify:ocean": "tsx scripts/verify-ocean.mjs",
    "verify:swim": "tsx scripts/verify-swim.mjs",
    "build:species": "tsx scripts/art/build-species.ts",
    "plates:sheet": "tsx scripts/art/plates-sheet.ts",
    "seed:supabase": "tsx scripts/seed-supabase.ts",
    "import:osm-sites": "tsx scripts/osm-sites/import.ts",
    "fetch:real-rarity": "tsx scripts/real-rarity/fetch.ts",
    "fetch:encounter-rarity": "tsx scripts/real-rarity/encounters.ts",
    "check:env": "tsx scripts/check-public-env.ts",
    "eas-build-post-install": "tsx scripts/check-public-env.ts --eas",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "check:buddy": "tsx scripts/check-buddy-verification.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|phosphor-react-native))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
